# Wails build output (keep build icons, manifests, and installer sources)
/build/bin/
# Temporary Windows resources generated by Wails
/*-res.syso

# Frontend dependencies and generated bundles
node_modules/
/frontend/dist/*
!/frontend/dist/gitkeep
!/frontend/dist/.gitkeep
*.tsbuildinfo
/frontend/coverage/
.vite/

# Go test and coverage output
*.test
*.prof
coverage.out
coverage.html

# Package manager and application logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example

# Editor and OS files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
